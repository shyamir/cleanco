# ====================
# Application Configuration
# ====================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ====================
# Database Configuration
# ====================
DATABASE_URL="postgresql://postgres:password@localhost:5432/cleanco?schema=public"

# ====================
# Redis Configuration
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====================
# JWT Configuration
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ====================
# Message Owl (OTP Service)
# ====================
MSGOWL_API_KEY=your-msgowl-api-key
MSGOWL_BASE_URL=https://api.msgowl.com/v1
MSGOWL_SENDER_ID=Cleanco

# ====================
# BML Payment Gateway
# ====================
BML_MERCHANT_ID=your-merchant-id
BML_SECRET_KEY=your-bml-secret-key
BML_BASE_URL=https://api.bankofmaldives.com
BML_REDIRECT_URL=http://localhost:3000/api/v1/payments/bml/callback
BML_WEBHOOK_URL=http://localhost:3000/api/v1/payments/bml/webhook

# ====================
# Google Cloud Platform
# ====================
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=cleanco-uploads
GCP_CREDENTIALS_PATH=./gcp-credentials.json

# ====================
# Firebase Cloud Messaging (Push Notifications)
# ====================
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# ====================
# Frontend URLs (for CORS and redirects)
# ====================
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
CLEANER_APP_URL=http://localhost:3003

# ====================
# Feature Flags
# ====================
USE_MOCK_OTP=true
ENABLE_AUTO_ASSIGNMENT=true
ENABLE_SAME_DAY_BOOKING=true
ENABLE_SUBSCRIPTION_AUTO_BILLING=true
MAX_RESCHEDULE_COUNT=1
MIN_BOOKING_NOTICE_HOURS=0
CANCEL_DEADLINE_HOURS=24

# ====================
# Business Configuration
# ====================
# Cleaner assignment rules
CLEANERS_FOR_1_BEDROOM=1
CLEANERS_FOR_2_BEDROOM=1
CLEANERS_FOR_3_BEDROOM=2
CLEANERS_FOR_4_BEDROOM=2
CLEANERS_FOR_4_BEDROOM_MAX=3

# Subscription billing
SUBSCRIPTION_INVOICE_DAYS_BEFORE=3
SUBSCRIPTION_APPOINTMENT_WEEKS=4

# Notification settings
BOOKING_REMINDER_HOURS_BEFORE=24

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ====================
# Logging & Monitoring
# ====================
LOG_LEVEL=info
SENTRY_DSN=

# ====================
# CORS Configuration
# ====================
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# ====================
# File Upload Configuration
# ====================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf
