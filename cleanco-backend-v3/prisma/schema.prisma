// This is your Prisma schema file for Cleanco Application
// Comprehensive database schema for home and office cleaning service platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  CUSTOMER
  CLEANER
  ADMIN
}

enum ServiceType {
  HOME
  OFFICE
}

enum BookingType {
  ONE_TIME
  SUBSCRIPTION
}

enum BookingStatus {
  PENDING           // Awaiting payment confirmation
  CONFIRMED         // Payment confirmed, awaiting cleaner assignment
  ASSIGNED          // Cleaners assigned
  IN_PROGRESS       // Cleaning in progress
  COMPLETED         // Cleaning completed
  CANCELED          // Booking canceled
  NO_SHOW           // Customer or cleaner no-show
}

enum PaymentStatus {
  PENDING           // Awaiting payment
  PAID              // Payment made, awaiting verification (for bank transfer)
  VERIFIED          // Payment verified
  REFUNDED          // Payment refunded
  FAILED            // Payment failed
}

enum PaymentMethod {
  BANK_TRANSFER
  BML_GATEWAY
}

enum SubscriptionFrequency {
  ONCE_A_WEEK
  TWICE_A_WEEK
  THRICE_A_WEEK
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
}

enum CleanerAssignmentStatus {
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  BOOKING_CONFIRMED
  CLEANER_ASSIGNED
  BOOKING_REMINDER
  PAYMENT_DUE
  BOOKING_CANCELED
  BOOKING_RESCHEDULED
  SUBSCRIPTION_RENEWAL
  PAYMENT_VERIFIED
  BOOKING_COMPLETED
  REVIEW_REQUEST
}

enum NotificationChannel {
  SMS
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(uuid())
  phoneNumber     String    @unique
  firstName       String?   // Optional - can be set during profile setup
  lastName        String?   // Optional - can be set during profile setup
  email           String?
  role            UserRole  @default(CUSTOMER)
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  fcmTokens       String[]  // For push notifications (multiple devices)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  addresses            Address[]
  bookings             Booking[]
  subscriptions        Subscription[]
  cleanerProfile       CleanerProfile?
  promoCodeUsages      PromoCodeUsage[]
  notifications        Notification[]
  reviews              Review[]
  complaints           Complaint[]
  refreshTokens        RefreshToken[]
  cleanerBlacklistBy   CleanerBlacklist[] @relation("CustomerBlacklist")

  @@index([phoneNumber])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String?  // "Home", "Office", etc.
  address       String   // House/Apt number, floor, etc.
  street        String   // Street/Magu
  landmark      String   // Landmark/Goalhi
  zoneId        String   // Reference to Zone
  latitude      Float?
  longitude     Float?
  isPrimary     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone          Zone     @relation(fields: [zoneId], references: [id])
  bookings      Booking[]
  subscriptions Subscription[]

  @@index([userId])
  @@index([zoneId])
  @@map("addresses")
}

model Service {
  id          String      @id @default(uuid())
  type        ServiceType
  name        String
  description String?
  isActive    Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@map("services")
}

model PricingRule {
  id              String                 @id @default(uuid())
  serviceType     ServiceType
  frequency       SubscriptionFrequency?

  // Home cleaning parameters
  bedrooms        Int?

  // Office cleaning parameters
  officeSize      String?  // Small, Medium, Large
  floors          Int?
  rooms           Int?

  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serviceType, frequency, bedrooms, officeSize, floors, rooms])
  @@index([serviceType])
  @@map("pricing_rules")
}

model TimeSlot {
  id               String    @id @default(uuid())
  startTime        String    // "08:00"
  endTime          String    // "09:45"
  displayStartTime String    // "08:00" (shown to customer)
  orderIndex       Int       // For sorting (1, 2, 3...)
  isActive         Boolean   @default(true)

  bookings         Booking[]
  subscriptions    Subscription[]
  availabilityCaches AvailabilityCache[]

  @@unique([startTime])
  @@index([orderIndex])
  @@map("time_slots")
}

model Booking {
  id                String        @id @default(uuid())
  bookingNumber     String        @unique // Human-readable booking number
  userId            String
  serviceType       ServiceType
  bookingType       BookingType
  status            BookingStatus @default(PENDING)

  // Address
  addressId         String

  // Scheduling
  date              DateTime      @db.Date
  timeSlotId        String

  // Home cleaning specific
  bedrooms          Int?
  bathrooms         Int?
  hasPets           Boolean       @default(false)

  // Office cleaning specific
  officeSize        String?
  floors            Int?
  rooms             Int?

  // Pricing
  frequency         SubscriptionFrequency?
  totalPrice        Decimal       @db.Decimal(10, 2)
  finalPrice        Decimal       @db.Decimal(10, 2)  // After discount
  promoCodeId       String?
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)

  // Payment
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod?
  adminApproved     Boolean       @default(false)

  // Special instructions
  specialInstructions String?

  // Subscription relation
  subscriptionId    String?

  // Cancellation & Rescheduling
  canceledAt        DateTime?
  cancelReason      String?
  rescheduledCount  Int           @default(0)
  originalDate      DateTime?     @db.Date
  originalTimeSlotId String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  user              User          @relation(fields: [userId], references: [id])
  address           Address       @relation(fields: [addressId], references: [id])
  timeSlot          TimeSlot      @relation(fields: [timeSlotId], references: [id])
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  promoCode         PromotionalCode? @relation(fields: [promoCodeId], references: [id])

  cleanerAssignments CleanerAssignment[]
  payments          Payment[]
  reviews           Review[]
  complaints        Complaint[]
  notifications     Notification[]

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([subscriptionId])
  @@index([bookingNumber])
  @@map("bookings")
}

model Subscription {
  id              String                @id @default(uuid())
  userId          String
  frequency       SubscriptionFrequency
  selectedDays    Int[]                 // Day of week: 0=Sunday, 1=Monday, etc.

  // Address and service details (same as booking)
  addressId       String
  serviceType     ServiceType
  bedrooms        Int?
  bathrooms       Int?
  hasPets         Boolean               @default(false)
  officeSize      String?
  floors          Int?
  rooms           Int?

  // Time slot
  timeSlotId      String

  // Billing
  monthlyPrice    Decimal               @db.Decimal(10, 2)
  nextBillingDate DateTime              @db.Date
  lastPaymentId   String?
  lastPaymentDate DateTime?

  // Status
  status          SubscriptionStatus    @default(ACTIVE)
  autoRenew       Boolean               @default(true)

  startDate       DateTime              @db.Date
  endDate         DateTime?             @db.Date

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relations
  user            User                  @relation(fields: [userId], references: [id])
  address         Address               @relation(fields: [addressId], references: [id])
  timeSlot        TimeSlot              @relation(fields: [timeSlotId], references: [id])
  bookings        Booking[]
  payments        Payment[]

  @@index([userId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

model CleanerProfile {
  id                String              @id @default(uuid())
  userId            String              @unique
  isAvailable       Boolean             @default(true)
  rating            Decimal?            @default(0) @db.Decimal(3, 2)
  totalJobs         Int                 @default(0)
  completedJobs     Int                 @default(0)
  profilePictureUrl String?
  bio               String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments       CleanerAssignment[]
  vacations         CleanerVacation[]
  blacklistedBy     CleanerBlacklist[]
  reviews           Review[]

  @@index([userId])
  @@map("cleaner_profiles")
}

model CleanerVacation {
  id        String   @id @default(uuid())
  cleanerId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cleaner   CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([startDate, endDate])
  @@map("cleaner_vacations")
}

model CleanerAssignment {
  id          String                   @id @default(uuid())
  bookingId   String
  cleanerId   String
  status      CleanerAssignmentStatus  @default(ASSIGNED)

  assignedAt  DateTime                 @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  notes       String?

  booking     Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner     CleanerProfile           @relation(fields: [cleanerId], references: [id])

  @@unique([bookingId, cleanerId])
  @@index([bookingId])
  @@index([cleanerId])
  @@index([status])
  @@map("cleaner_assignments")
}

model CleanerBlacklist {
  id         String   @id @default(uuid())
  customerId String
  cleanerId  String
  reason     String?
  createdBy  String?  // Admin user ID

  createdAt  DateTime @default(now())

  customer   User           @relation("CustomerBlacklist", fields: [customerId], references: [id], onDelete: Cascade)
  cleaner    CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([customerId, cleanerId])
  @@index([customerId])
  @@index([cleanerId])
  @@map("cleaner_blacklists")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String?       // Optional: for booking payments
  subscriptionId  String?       // Optional: for subscription renewal payments
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  // Bank Transfer
  receiptUrl      String?

  // BML Gateway
  transactionId   String?       @unique
  bmlOrderId      String?
  bmlResponse     Json?

  paidAt          DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?       // Admin user ID

  failureReason   String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking?      @relation(fields: [bookingId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([bookingId])
  @@index([subscriptionId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model PromotionalCode {
  id                  String       @id @default(uuid())
  code                String       @unique
  discountType        DiscountType
  discountValue       Decimal      @db.Decimal(10, 2)

  startDate           DateTime     @db.Date
  endDate             DateTime     @db.Date

  usageLimitPerUser   Int          @default(1)
  totalUsageLimit     Int?
  currentUsage        Int          @default(0)

  applicableServices  ServiceType[]
  minPurchaseAmount   Decimal?     @db.Decimal(10, 2)

  isActive            Boolean      @default(true)
  isPublic            Boolean      @default(true) // false = private, only via customer support
  createdBy           String       // Admin user ID

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  usages              PromoCodeUsage[]
  bookings            Booking[]

  @@index([code])
  @@index([isActive])
  @@map("promotional_codes")
}

model PromoCodeUsage {
  id             String    @id @default(uuid())
  promoCodeId    String
  userId         String
  bookingId      String
  discountAmount Decimal   @db.Decimal(10, 2)

  usedAt         DateTime  @default(now())

  promoCode      PromotionalCode @relation(fields: [promoCodeId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_code_usages")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)

  title     String
  message   String
  data      Json?               // Additional data (booking ID, etc.)

  bookingId String?

  sentAt    DateTime?
  readAt    DateTime?

  failureReason String?

  createdAt DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model Review {
  id          String    @id @default(uuid())
  bookingId   String    @unique
  userId      String
  cleanerId   String?

  rating      Int       // 1-5
  comment     String?
  response    String?   // Admin or cleaner response

  isVisible   Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id])
  cleaner     CleanerProfile? @relation(fields: [cleanerId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([cleanerId])
  @@map("reviews")
}

model Complaint {
  id          String            @id @default(uuid())
  bookingId   String?
  userId      String

  subject     String
  description String
  status      ComplaintStatus   @default(OPEN)
  priority    ComplaintPriority @default(MEDIUM)

  assignedTo  String?           // Admin user ID
  resolution  String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  user        User              @relation(fields: [userId], references: [id])
  booking     Booking?          @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("complaints")
}

model BlackoutDate {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  reason      String   // "Public Holiday", "Maintenance", etc.
  isRecurring Boolean  @default(false) // For annual holidays

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("blackout_dates")
}

model AvailabilityCache {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  timeSlotId      String

  totalCapacity   Int      // Total cleaners available
  bookedCapacity  Int      // Cleaners already booked

  lastUpdated     DateTime @updatedAt

  timeSlot        TimeSlot @relation(fields: [timeSlotId], references: [id])

  @@unique([date, timeSlotId])
  @@index([date])
  @@map("availability_caches")
}

// System configuration table for dynamic settings
model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// Zone for address selection (Male, Hulhumale, etc.)
model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  orderIndex Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]

  @@index([orderIndex])
  @@map("zones")
}
